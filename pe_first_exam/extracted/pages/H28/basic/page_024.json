    {
      "confidence" : 1,
      "height" : 0.015988371107313326,
      "text" : "ベーションを生みだすことを料学技術コミュニケーションと呼ぶ。このような用語こ",
      "width" : 0.68583160732504533,
      "x" : 0.18891170487957187,
      "y" : 0.76308139582715728
    },
    {
      "confidence" : 1,
