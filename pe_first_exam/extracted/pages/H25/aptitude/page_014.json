      "y" : 0.67863247885050182
    },
    {
      "confidence" : 1,
      "height" : 0.016015702435094092,
      "text" : "ウ）他人の外国語論文の記述を、自分が作成する日本語論文の中で引用して利用する場合",
      "width" : 0.72279262082012363,
