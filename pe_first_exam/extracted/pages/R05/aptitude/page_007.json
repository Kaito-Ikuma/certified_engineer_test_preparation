    },
    {
      "confidence" : 0.5,
      "height" : 0.020816710056402843,
      "text" : "次の「科学者の行動規範」に関する（ア）～（エ）の記述について、正しいものはO，",
      "width" : 0.69839031030362009,
      "x" : 0.17236688324380234,
