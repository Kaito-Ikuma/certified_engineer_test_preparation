      "y" : 0.82264957299235464
    },
    {
      "confidence" : 1,
      "height" : 0.017590936024983739,
      "text" : "一般の産業や工事においても、安全を確保しているとされる機械や施工において事故が発",
      "width" : 0.72895274876396432,
      "x" : 0.14579056370836699,
      "y" : 0.79651162775151407
    },
    {
      "confidence" : 0.5,
      "height" : 0.015995825254000118,
