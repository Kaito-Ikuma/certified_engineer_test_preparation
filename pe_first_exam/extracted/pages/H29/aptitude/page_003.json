    {
      "confidence" : 0.5,
      "height" : 0.01765305119701932,
      "text" : "調で、あなた自身もうれしく思っていた。しかしながら、予想を上回る売れ行きの結果，",
      "width" : 0.71457904318104615,
      "x" : 0.1519507299201838,
