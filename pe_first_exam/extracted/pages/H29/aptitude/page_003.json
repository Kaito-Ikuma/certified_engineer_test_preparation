      "width" : 0.72073917112488672,
      "x" : 0.15195074676130738,
      "y" : 0.81666666695730483
    },
    {
      "confidence" : 1,
      "height" : 0.017441860427204414,
      "text" : "かつ安く納入することができる」との提案をしてきた。この問題を考える上で重要な事項",
      "width" : 0.72484599680140394,
      "x" : 0.15195071985391814,
      "y" : 0.792151162635235
    },
    {
      "confidence" : 1,
      "height" : 0.015988371107313437,
