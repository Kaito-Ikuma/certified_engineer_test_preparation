      "x" : 0.17248459994656676,
      "y" : 0.77179487194209839
    },
    {
      "confidence" : 0.5,
      "height" : 0.016239316239316182,
      "text" : "④ 触媒により、いくつかの可能な反応のうちで特定のものを選択的に進行させることが",
      "width" : 0.7268993373072854,
      "x" : 0.15195074808147019,
      "y" : 0.74700854703646602
    },
    {
      "confidence" : 0.30000001192092896,
      "height" : 0.015988371107313326,
      "text" : "できる。",
      "width" : 0.063655027599403918,
