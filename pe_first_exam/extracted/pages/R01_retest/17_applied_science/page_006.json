      "y" : 0.72093023306552939
    },
    {
      "confidence" : 0.5,
      "height" : 0.01762572068434487,
      "text" : "⑤ 反応速度の増大により、等圧等温系でも化学平衡の位置が変化する。",
      "width" : 0.59137575456280222,
      "x" : 0.15195072148656602,
      "y" : 0.6947674418309715
    },
    {
