      "y" : 0.83575581439443303
    },
    {
      "confidence" : 0.5,
      "height" : 0.015988371107313326,
      "text" : "（ア）真の著者からの好意や真の著者に対する強制によって、著者の要件を満たしていない",
      "width" : 0.73305950072652482,
      "x" : 0.14373719925172709,
